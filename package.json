{
  "name": "sharepoint-site-request-agent",
  "version": "0.1.0",
  "description": "Reference implementation for a governed SharePoint site request/provisioning agent with M365 Copilot, Copilot Studio, Power Automate, Purview, MCP, and A2A integration contracts.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:tenant": "pwsh -File scripts/test-tenant-access.ps1",
    "validate": "npm run build && npm test"
  },
  "keywords": [
    "sharepoint",
    "copilot-studio",
    "mcp",
    "a2a",
    "power-automate",
    "purview"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
